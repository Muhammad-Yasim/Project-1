import json


def friends(friends_list):
    names=[]
    for f in friends_list:
        for user in data['users']:
            if f==user['id']:
                names.append(user['name'])
    if len(names)==0:
        return "No friends"
    elif len(names)==1:
        return names[0]
    elif len(names)==2:
        return " and ".join(names)
    else:
        return ",".join(names[:-1]) + " and " + names[-1]








def friends_suggestions(user):
    friends_list= user['friends']
    mutual_friends_list=[]
    
    for i in friends_list:
        for j in data['users']:
            if i==j['id']:
                mutual_friends_list.extend(j['friends'])     #using .extend instead of .append to get flat valeus instead of whole list
                
    mutual_friends_list=[id for id in mutual_friends_list if id!=user['id'] and id not in user['friends'] ]     #For removing self as friend and removing those who are already friends
    
    
    
    
       #FOR PRIORITY COUNTING
    suggestion_priority={}          #Empty dictionary
    for s in set(mutual_friends_list):      #Converting to set so that each is iterated only once  
        count=mutual_friends_list.count(s)      #counting number of times a value repeats
        suggestion_priority[s]=count          #Now our dictionary contains each value 1 time,along with their count
    #print(suggestion_priority)
    
    
    
       #FOR ARRANGING THESE VALUES according to Priority
    sorted_suggestion_priority=sorted( suggestion_priority , key=lambda x:suggestion_priority[x] , reverse=True )     #Here it is converted to list form
                                                                                                                      #List is created based on sorting in descending order due to sorted,reverse=True
                                                                                                                      #suggestion_priority is parameter as value i.e iteratable object
                                                                                                                      #Key here is used to tell what values to add up.By default,it sorts based on keys.But we are using it here so that we can be able to do it on our own choice
                                                                                                                      #suggestion_priority[x] returns us values,not the keys
    #print(sorted_suggestion_priority) 

    
    
    
    print(f"People {user['name']} May Know : {friends(sorted_suggestion_priority)}") 


data=json.load(open("data3.json"))


for user in data['users']:
    friends_suggestions(user)






